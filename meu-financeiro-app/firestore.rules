rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados pessoais: cada conta só acessa a própria pasta
    match /usuarios/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Modo família ----------

    function familia(fid) {
      return get(/databases/$(database)/documents/familias/$(fid)).data;
    }

    function membro(fid) {
      return request.auth != null && request.auth.uid in familia(fid).membros;
    }

    function mudou() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // o código usado para entrar existe, é desta família, ainda vale, não tinha sido usado
    // e fica marcado como usado por esta pessoa na mesma gravação (cada código serve para uma pessoa)
    function conviteUsadoAgora(fid) {
      let caminho = /databases/$(database)/documents/convites/$(request.resource.data.ultimoConvite);
      return exists(caminho)
        && get(caminho).data.familia == fid
        && get(caminho).data.expiraEm > request.time
        && get(caminho).data.get('usadoPor', null) == null
        && getAfter(caminho).data.get('usadoPor', null) == request.auth.uid;
    }

    match /familias/{fid} {
      // ler: só quem é da família
      allow read: if request.auth != null && request.auth.uid in resource.data.membros;

      // criar: quem cria vira a dona/o dono e a única pessoa da lista
      allow create: if request.auth != null
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.membros == [request.auth.uid];

      allow update: if request.auth != null && (
        // quem é da família salva os dados (sem mexer em quem é da família)
        (request.auth.uid in resource.data.membros
          && mudou().hasOnly(['versao', 'partes', 'gzip', 'formato', 'fotos', 'atualizadoEm', 'aparelho']))
        // a dona/o dono cuida da lista de pessoas, dos convites e do nome (e continua na família)
        || (request.auth.uid == resource.data.dono
          && request.resource.data.dono == resource.data.dono
          && request.auth.uid in request.resource.data.membros)
        // entrar com um código de convite: coloca só a si mesmo na lista
        || (!(request.auth.uid in resource.data.membros)
          && mudou().hasOnly(['membros', 'nomes', 'ultimoConvite'])
          && request.resource.data.membros == resource.data.membros.concat([request.auth.uid])
          && request.resource.data.nomes.diff(resource.data.nomes).affectedKeys().hasOnly([request.auth.uid])
          && conviteUsadoAgora(fid))
        // sair: tira só a si mesmo da lista (a dona/o dono encerra a família em vez de sair)
        || (request.auth.uid in resource.data.membros
          && request.auth.uid != resource.data.dono
          && mudou().hasOnly(['membros', 'nomes'])
          && request.resource.data.membros == resource.data.membros.removeAll([request.auth.uid])
          && request.resource.data.nomes.diff(resource.data.nomes).affectedKeys().hasOnly([request.auth.uid]))
      );

      // encerrar: só a dona/o dono
      allow delete: if request.auth != null && request.auth.uid == resource.data.dono;

      // dados e fotos da família: só quem é da família
      match /{colecao}/{documento} {
        allow read, write: if membro(fid);
      }
    }

    // convites: quem tem o código consegue ler (não dá para listar); só a dona/o dono cria e apaga
    match /convites/{codigo} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.criadoPor == request.auth.uid
        && familia(request.resource.data.familia).dono == request.auth.uid
        && request.resource.data.expiraEm < request.time + duration.value(8, 'd')
        && !('usadoPor' in request.resource.data);
      // usar o código: só uma vez, dentro do prazo e junto com a entrada na família (mesma gravação)
      allow update: if request.auth != null
        && resource.data.get('usadoPor', null) == null
        && resource.data.expiraEm > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usadoPor', 'usadoEm'])
        && request.resource.data.usadoPor == request.auth.uid
        && !(request.auth.uid in familia(resource.data.familia).membros)
        && request.auth.uid in getAfter(/databases/$(database)/documents/familias/$(resource.data.familia)).data.membros;
      allow delete: if request.auth != null && resource.data.criadoPor == request.auth.uid;
    }
  }
}
